{
  "expo": {
    "name": "LettuceCare",
    "slug": "lettucecare",
    "owner": "lettucecares-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lettucecare-logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/images/lettucecare-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lettucecares.lettucecare"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8F5E9",
          "image": "./assets/images/lettucecare-logo.png",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30978e3a-f9d5-43a5-a637-e820e8b58dd2"
      }
    }
  }
}